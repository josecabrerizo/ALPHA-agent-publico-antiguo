{
  "name": "@alpha/engine",
  "version": "0.0.1",
  "private": true,
  "description": "Motor headless de A.L.P.H.A.: audio, STT, TTS, vision, cerebro e IPC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "prepare": "tsc --build",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/spikes/**\" \"src/**/*.test.ts\"",
    "spike:stt": "tsx src/spikes/stt.ts",
    "spike:stt-file": "tsx src/spikes/stt-file.ts",
    "spike:system": "tsx src/spikes/system.ts",
    "spike:brain": "tsx src/spikes/brain.ts",
    "devices": "tsx src/spikes/devices.ts",
    "mic-check": "tsx src/spikes/mic-check.ts",
    "spike:tts": "tsx src/spikes/tts.ts",
    "spike:conversar": "tsx src/spikes/conversar.ts",
    "spike:agente": "tsx src/spikes/agente.ts"
  },
  "dependencies": {
    "@alpha/protocol": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "audify": "^1.10.1",
    "msedge-tts": "^2.0.7",
    "openai": "^6.48.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
