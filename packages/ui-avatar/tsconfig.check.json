{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Comprobacion, sin emitir: como tsconfig.json pero CON los *.test.ts.
  // Ver packages/engine/tsconfig.check.json para el porque.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
