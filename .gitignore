node_modules/
dist/
*.tsbuildinfo

# Binarios y modelos descargados por tools/fetch-whisper.mjs (cientos de MB)
vendor/
models/

# Grabaciones y capturas temporales del motor
.tmp/
*.wav
*.png

# ...pero los retratos de los avatares son parte del producto: sin ellos, un
# clon nuevo se queda sin caras.
!assets/avatars/*.png

# Secretos: claves de proveedores de nube
.env
.env.*
config/local.yaml

# Configuracion en vivo del asistente (la edita el menu del avatar)
config/alpha.settings.json

# Token de sesion del puente motor<->avatar (uno nuevo por arranque). Hay uno
# por puerto: alpha.bridge-token.43118 para una segunda instancia, y el .tmp
# intermedio del reemplazo atomico si algo se corta a mitad.
config/alpha.bridge-token*

.DS_Store
Thumbs.db
