node_modules/
dist/
*.tsbuildinfo

# Binarios y modelos descargados por tools/fetch-whisper.mjs (cientos de MB)
vendor/
models/

# Grabaciones y capturas temporales del motor
.tmp/
*.wav
*.png

# ...pero los retratos de los avatares son parte del producto: sin ellos, un
# clon nuevo se queda sin caras. La segunda linea es para las POSES, que viven
# en una subcarpeta por avatar (unit-a/reposo.png): sin ella se colaban por el
# *.png de arriba y un clon nuevo tenia el personaje quieto.
!assets/avatars/*.png
!assets/avatars/*/*.png

# Secretos: claves de proveedores de nube
.env
.env.*
config/local.yaml

# Configuracion en vivo del asistente (la edita el menu del avatar)
config/alpha.settings.json

# Token de sesion del puente motor<->avatar: desde @alpha/protocol vive en
# ~/.alpha (fuera del repo). La regla se queda para que un fichero dejado por
# un checkout anterior a la mudanza no acabe commiteado.
config/alpha.bridge-token*

.DS_Store
Thumbs.db
