{
  "name": "alpha-agent",
  "version": "0.0.1",
  "private": true,
  "description": "A.L.P.H.A. — el agente: motor headless (audio, STT, TTS, vision, cerebro e IPC)",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup:stt": "node tools/fetch-whisper.mjs",
    "spike:stt": "npm run spike:stt --workspace @alpha/engine",
    "spike:stt-file": "npm run spike:stt-file --workspace @alpha/engine --",
    "spike:system": "npm run spike:system --workspace @alpha/engine",
    "spike:brain": "npm run spike:brain --workspace @alpha/engine",
    "devices": "npm run devices --workspace @alpha/engine",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build && tsc -p packages/engine/tsconfig.check.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "mic-check": "npm run mic-check --workspace @alpha/engine",
    "spike:tts": "npm run spike:tts --workspace @alpha/engine --",
    "spike:conversar": "npm run spike:conversar --workspace @alpha/engine",
    "spike:agente": "npm run spike:agente --workspace @alpha/engine"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
