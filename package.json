{
  "name": "digitaltpm-alpha",
  "version": "0.0.1",
  "private": true,
  "description": "A.L.P.H.A. — Asistente Local Proactivo Hibrido Abierto",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup:stt": "node tools/fetch-whisper.mjs",
    "spike:stt": "npm run spike:stt --workspace @alpha/engine",
    "spike:stt-file": "npm run spike:stt-file --workspace @alpha/engine --",
    "spike:system": "npm run spike:system --workspace @alpha/engine",
    "spike:brain": "npm run spike:brain --workspace @alpha/engine",
    "avatar": "npm run dev --workspace @alpha/ui-avatar",
    "devices": "npm run devices --workspace @alpha/engine",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --build",
    "mic-check": "npm run mic-check --workspace @alpha/engine",
    "spike:tts": "npm run spike:tts --workspace @alpha/engine --",
    "spike:conversar": "npm run spike:conversar --workspace @alpha/engine",
    "spike:agente": "npm run spike:agente --workspace @alpha/engine"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
