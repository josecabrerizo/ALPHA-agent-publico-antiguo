{
  "version": "0.2.0",
  "configurations": [
    {
      // Cualquier spike del motor (audio, cerebro, voz...) bajo el depurador.
      // Cambia "program" al spike que quieras depurar.
      "name": "Motor: spike actual (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "program": "${workspaceFolder}/packages/engine/src/spikes/brain.ts",
      "cwd": "${workspaceFolder}/packages/engine",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
